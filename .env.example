# ── LLM Provider ───────────────────────────────────────────
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ── NVIDIA ─────────────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Gemini ─────────────────────────────────────────────────
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# ── OpenAI ─────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── Anthropic ──────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-20251001
ANTHROPIC_API_KEY=

# ── OpenRouter ─────────────────────────────────────────────
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Ollama (local) ─────────────────────────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── Custom OpenAI-compatible endpoint ──────────────────────
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# ── Embedding Provider ─────────────────────────────────────
# "local" (default) or "jina"
EMBEDDING_PROVIDER=jina

# ── Jina AI Embeddings ─────────────────────────────────────
JINA_API_KEY=
# Model: jina-embeddings-v5-text-small (default)

# ── Local Embedding Model ──────────────────────────────────
# Used when EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Data refresh ───────────────────────────────────────────
REFRESH_SOURCE=
REFRESH_TEST_SET=

# ── Ragas ──────────────────────────────────────────────────
RUN_RAGAS=
