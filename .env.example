# ── LLM Provider ───────────────────────────────────────────
# Chọn MỘT provider, uncomment và điền key tương ứng.
LLM_PROVIDER=nvidia
LLM_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ── NVIDIA (default for this project) ──────────────────────
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Gemini ─────────────────────────────────────────────────
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=

# ── OpenAI ─────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# ── Anthropic ──────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-20251001
ANTHROPIC_API_KEY=

# ── OpenRouter ─────────────────────────────────────────────
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Ollama (local — no API key needed) ─────────────────────
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── Custom OpenAI-compatible endpoint ──────────────────────
# LLM_PROVIDER=custom
# LLM_MODEL=your-model-name
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# ── Data refresh flags ─────────────────────────────────────
# Set to "1" or "true" to force re-fetch / re-build.
REFRESH_SOURCE=
REFRESH_TEST_SET=

# ── Ragas evaluation ───────────────────────────────────────
# Set to "1" or "true" to enable the heavier Ragas metric pass.
RUN_RAGAS=
